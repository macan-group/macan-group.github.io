# Copy to scripts/deploy.env (gitignored) and fill in.
# Create a dedicated FTP account in cPanel -> "FTP Accounts", scoped to the
# site's document root, and use those credentials here.

FTP_HOST=ftp.macanco.com
FTP_USER=deploy@macanco.com
FTP_PASS=change-me
FTP_PORT=21

# cPanel document root for the site:
#   primary domain -> public_html
#   addon domain   -> public_html/macanco.com
FTP_DIR=public_html
