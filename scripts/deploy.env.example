# Copy to scripts/deploy.env (gitignored) and fill in.

# Server hostname or IP. If your domain's DNS isn't live yet, use the
# cPanel server hostname (the host before ":2083" in the cPanel URL) or the
# Shared IP Address from cPanel -> Server Information. Bare host only:
#   ok:  server231.web-hosting.com   198.51.100.20
#   no:  ftp://host   host:21   https://host
FTP_HOST=server231.web-hosting.com

# FTP account (cPanel -> FTP Accounts), usually the full user@domain form.
# For SFTP, this is normally your MAIN cPanel account username instead.
FTP_USER=deploy@macanco.com
FTP_PASS=change-me

# cPanel document root:
#   primary domain -> public_html
#   addon domain   -> public_html/macanco.com
FTP_DIR=public_html

# Transport: ftps (default, port 21 + TLS) | ftp (plain) | sftp (port 22, SSH)
DEPLOY_PROTOCOL=ftps

# Only set if the port is non-standard (21 for ftp/ftps, 22 for sftp).
#FTP_PORT=
