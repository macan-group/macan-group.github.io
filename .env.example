# Copy to .env.local and rebuild (`npm run build`) to take effect.
# All NEXT_PUBLIC_* values are inlined into the static export at build time.

# --- Analytics (optional) -------------------------------------------------
# Leave unset to ship with no tracking at all.
#
# Plausible (hosted):
#   NEXT_PUBLIC_ANALYTICS_SRC=https://plausible.io/js/script.js
#   NEXT_PUBLIC_ANALYTICS_DOMAIN=macanco.com
#
# Umami (self-hosted or cloud):
#   NEXT_PUBLIC_ANALYTICS_SRC=https://cloud.umami.is/script.js
#   NEXT_PUBLIC_ANALYTICS_WEBSITE_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
#
# Cloudflare Web Analytics:
#   NEXT_PUBLIC_ANALYTICS_SRC=https://static.cloudflareinsights.com/beacon.min.js
#   (add the token in the CF dashboard; no domain/id needed here)
NEXT_PUBLIC_ANALYTICS_SRC=
NEXT_PUBLIC_ANALYTICS_DOMAIN=
NEXT_PUBLIC_ANALYTICS_WEBSITE_ID=
